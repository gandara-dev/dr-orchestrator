{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gandara-dev/dr-orchestrator/blob/main/schemas/runbook.schema.json",
  "title": "DR Orchestrator runbook",
  "description": "A dependency-ordered disaster recovery workflow.",
  "type": "object",
  "required": ["name", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "const": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "name", "provider", "action", "parameters"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "enum": ["VMware", "Windows"] },
        "action": { "type": "string", "minLength": 1 },
        "expectedDurationSeconds": {
          "description": "Planned duration used by Get-DrRecoveryPlan and the Runbook Viewer.",
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "parameters": {
          "type": "object",
          "properties": {
            "vmNames": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "server": { "type": "string", "minLength": 1 },
            "computerName": { "type": "string", "minLength": 1 },
            "serviceName": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "uri": { "type": "string", "pattern": "^https?://" },
            "timeoutSeconds": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["provider"],
            "properties": { "provider": { "const": "VMware" } }
          },
          "then": {
            "properties": {
              "action": { "enum": ["StartVM", "WaitForTools", "TestVM"] }
            }
          }
        },
        {
          "if": {
            "required": ["provider"],
            "properties": { "provider": { "const": "Windows" } }
          },
          "then": {
            "properties": {
              "action": { "enum": ["StartService", "TestTcpPort", "TestHttp"] }
            }
          }
        },
        {
          "if": {
            "required": ["action"],
            "properties": {
              "action": { "enum": ["StartVM", "WaitForTools", "TestVM"] }
            }
          },
          "then": {
            "properties": { "parameters": { "required": ["vmNames"] } }
          }
        },
        {
          "if": {
            "required": ["action"],
            "properties": { "action": { "const": "StartService" } }
          },
          "then": {
            "properties": {
              "parameters": { "required": ["computerName", "serviceName"] }
            }
          }
        },
        {
          "if": {
            "required": ["action"],
            "properties": { "action": { "const": "TestTcpPort" } }
          },
          "then": {
            "properties": {
              "parameters": { "required": ["computerName", "port"] }
            }
          }
        },
        {
          "if": {
            "required": ["action"],
            "properties": { "action": { "const": "TestHttp" } }
          },
          "then": {
            "properties": { "parameters": { "required": ["uri"] } }
          }
        }
      ]
    }
  }
}
